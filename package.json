{
  "name": "professional-network-message-exporter",
  "version": "1.0.0",
  "description": "A local tool for exporting messages from LinkedIn to validated JSON.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavelgloss/professional-network-message-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/pavelgloss/professional-network-message-exporter/issues"
  },
  "homepage": "https://github.com/pavelgloss/professional-network-message-exporter#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "login": "tsx src/cli.ts login",
    "export": "tsx src/cli.ts export",
    "probe:read-thread": "tsx src/cli.ts export --probe-read-thread",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "playwright": "^1.55.0",
    "write-file-atomic": "^6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@types/write-file-atomic": "^4.0.3",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
